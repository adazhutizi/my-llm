# ── 服务 ───────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── 数据库（MySQL）──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# 必填：数据库密码
DB_PASSWORD=password
DB_NAME=llm_gateway

# ── JWT（管理后台鉴权）─────────────────────────────────────────────
# 必填，>=16 字符：JWT 签名密钥，请改为长随机串
JWT_SECRET=change-me
# JWT 有效期（秒），默认 24 小时
JWT_EXPIRES_IN=86400
# 滑动续期阈值（秒）：剩余寿命低于此值时管理后台请求自动续签；改 JWT_EXPIRES_IN 时需同步（默认约为其 1/3）
JWT_RENEW_THRESHOLD=28800

# ── Redis（强依赖：限流令牌桶 / 配额缓存 / 归档选主锁 / 迁移锁）──────
# 必填：Redis 地址，TLS 用 rediss:// scheme；启动时 ping 不通会直接退出
REDIS_URL=redis://localhost:6379
# Redis 密码，生产通常必填
REDIS_PASSWORD=
# Redis 6+ ACL 用户名，留空走经典 AUTH
REDIS_USERNAME=
# key 前缀，多套网关共享同一 Redis 时隔离
REDIS_KEY_PREFIX=llmgw:
# 断连排队重试次数；设小值让 Redis 不可达时快速 reject（配合超时实现 fail-open）
REDIS_MAX_RETRIES=1
# 已发出命令的超时（ms）；maxRetries 只管断连排队、不管慢响应——不配则 Redis 卡顿会拖垮限流
REDIS_COMMAND_TIMEOUT_MS=1000
# 连接建立超时（ms）
REDIS_CONNECT_TIMEOUT_MS=2000
